# Fins de ligne normalisées en LF (recommandé pour Godot)
* text=auto eol=lf

# Fichiers binaires
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.ogg binary
*.wav binary
*.mp3 binary
*.ttf binary
*.otf binary
*.glb binary

# Images de carte : Git LFS
data/map/*.png filter=lfs diff=lfs merge=lfs -text

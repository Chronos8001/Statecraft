{
  "unrest_wave": {
    "title_key": "EVENT_UNREST_WAVE_TITLE",
    "desc_key": "EVENT_UNREST_WAVE_DESC",
    "scope": "country",
    "trigger": {"stability": "<35"},
    "mtth_months": 24,
    "mtth_modifiers": [{"factor": 0.5, "if": {"stability": "<20"}}],
    "options": [
      {"name_key": "EVENT_UNREST_WAVE_A", "effects": {"add_group_satisfaction": {"workers": 3, "middle_class": 2}, "add_debt": 2},

      {"name_key": "EVENT_UNREST_WAVE_B", "effects": {"add_stability": 4,
        "if": {"democratic": true}, "then": {"add_legitimacy": -6}, "else": {"add_legitimacy": -2}},
        "ai_weight": 1, "ai_modifiers": [{"factor": 3, "if": {"democratic": false}}]}
    ]
  },
  "social_media_scandal": {

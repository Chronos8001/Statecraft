    "trigger": {"democratic": true, "law": {"social_networks": "free"}},
    "mtth_months": 72,
    "options": [
      {"name_key": "EVENT_SOCIAL_MEDIA_SCANDAL_A", "effects": {"add_legitimacy": -2}, "ai_weight": 2},
      {"name_key": "EVENT_SOCIAL_MEDIA_SCANDAL_B", "effects": {"add_stability": -1,
